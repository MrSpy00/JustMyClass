# JustMyClass - derleme ortami sabloni
#
# Bu dosyayi `.env` olarak kopyalayin ve degerleri kendi ortaminiza gore
# doldurun. `.env` .gitignore'dadir ve depoya yuklenmez.
#
# ---------------------------------------------------------------------
# Google OAuth
# ---------------------------------------------------------------------
# Google Cloud Console > API'ler ve Hizmetler > Kimlik Bilgileri
#   > "Masaustu (Desktop)" turunde olusturulmus OAuth istemcisinin
#   Client ID ve Client Secret degerleri.
#
# NOT: Bu degerler kaynak kodda düz metin olarak bulunmaz. Derleme aninda
# maskelenerek yalnizca Electron ana surecine (main process) aktarilir.
JMC_GOOGLE_CLIENT_ID=
JMC_GOOGLE_CLIENT_SECRET=